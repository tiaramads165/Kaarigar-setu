# Template only: real values are generated by ./scripts/compose-setup.sh into ".env" (git-ignored). Never commit secrets.
DB_NAME=kaarigar_setu
DB_OWNER_PASSWORD=
DB_PASSWORD=
ML_INTERNAL_TOKEN=
PHONE_ENC_KEY=
DATA_ENC_KEYS=
PHONE_HMAC_KEY=
OTP_PEPPER=
AUDIT_HMAC_KEY=
KEYSTORE_PASSWORD=
TWO_PERSON_ACTIONS=VET_EMPLOYER,DISPUTE_DECISION
OTP_POW_BITS=16
TRUSTED_DEVICE_DAYS=180
MAX_TRUSTED_DEVICES=5
# --- Replay-voice detection (docs/REPLAY_DETECTION.md). Defaults are calibrated; REPLAY_DETECTION cannot be switched off when APP_ENV=prod.
REPLAY_CHALLENGE=true
REPLAY_CHALLENGE_TRIES=3
REPLAY_CHALLENGE_MINUTES=15
REPLAY_DETECTION=true
REPLAY_MIN_MATCHES=25
REPLAY_MIN_LANDMARKS=100
REPLAY_TEXT_MIN_SHINGLES=14
REPLAY_TEXT_MIN_COMMON=8
REPLAY_TEXT_MIN_SHARE=0.5
PUBLIC_BASE_URL=https://localhost:8443
PUBLIC_HOST=localhost
APP_ENV=staging
STT_PROVIDER=stub
WITH_WHISPER=0
WHISPER_MODEL=large-v3-turbo
LLM_API_KEY=

# --- SMS delivery of one-time codes (docs/SMS_SETUP.md). console = codes are only logged (development / closed pilot).
SMS_PROVIDER=console
SMS_URL=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_VALUE=
SMS_CONTENT_TYPE=json
SMS_BODY=
SMS_SENDER=
